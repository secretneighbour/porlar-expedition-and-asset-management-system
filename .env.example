# ============================================================================
# POLAR EXPEDITION & ASSET MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# Production Reference Specification (.env.example)
# Compatible with Vercel Serverless Functions, Next.js, Vite, and Multi-Device Units
# ============================================================================

# ============================================================================
# 1. CLIENT-SIDE VARIABLES (Safe to expose to browser)
# Prefixed with NEXT_PUBLIC_ (and VITE_ for Vite bundler compatibility)
# ============================================================================

# Supabase Public API Gateway URL (e.g. https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=""
VITE_SUPABASE_URL=""

# Supabase Client-Safe Anonymous Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
VITE_SUPABASE_ANON_KEY=""

# Google Maps Platform Key (for client-side terrain & satellite maps)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_API_KEY=""

# Dedicated WebSocket Server URL (Optional; leave empty for Vercel Serverless HTTP sync)
NEXT_PUBLIC_WS_URL=""
VITE_WS_URL=""

# API Base URL (Leave empty for same-origin relative /api/... requests on Vercel)
# Only specify if targeting an external standalone backend from a native mobile build
NEXT_PUBLIC_API_BASE_URL=""
VITE_API_BASE_URL=""
VITE_API_URL=""
VITE_BACKEND_URL=""

# ============================================================================
# 2. SERVER-SIDE VARIABLES (NEVER expose to browser / client bundles)
# Evaluated strictly inside Vercel Serverless Functions and Node.js server.ts
# ============================================================================

# Google Gemini API Key for autonomous SAR, route optimization & predictive analytics
GEMINI_API_KEY=""

# Cryptographic secret for signing authoritative stateless HMAC-SHA256 session tokens
AUTH_SECRET="polar-ops-secret-key-2026"
JWT_SECRET="polar-ops-secret-key-2026"

# Supabase Privileged Service-Role Key (server-side only)
SUPABASE_SERVICE_ROLE_KEY=""

# Cloud / PostgreSQL Database URL (Optional; uses local JSON / serverless memory fallback)
DATABASE_URL=""

# Local Platform Database Storage Path (development server fallback)
DATABASE_PATH="./data/polar-database.json"

# Server Network Ingress Binding (Local development)
PORT=3000
HOST="0.0.0.0"

# Public URL of the deployment (used for mobile pairing QR codes)
APP_URL="http://localhost:3000"

# Comma-delimited list of permitted CORS origins (supports wildcards, LAN, and Vercel)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,tauri://localhost,https://tauri.localhost"

# ============================================================================
# 3. OPTIONAL SERVICES
# ============================================================================

# Polar Satellite Uplink API Key (optional external satellite link)
POLAR_SATELLITE_UPLINK_KEY=""

# Set to true to disable Vite HMR in restricted container environments
DISABLE_HMR="false"

# ============================================================================
# 4. CI/CD & CLOUDFLARE BUILD CONFIGURATION
# ============================================================================

# Cloudflare Pages / Workers Build Image Bun Version Override
# Set in Cloudflare Dashboard -> Settings -> Build & Deployments -> Environment variables
BUN_VERSION="1.4.2"

