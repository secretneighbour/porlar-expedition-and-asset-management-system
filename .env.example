# Polar Expedition Operations Telemetry & Workstation Configuration

# ============================================================================
# SERVER & NETWORK BINDING (Shared Backend for Multi-PC Deployments)
# ============================================================================
# PORT: Local and container binding port (default: 3000)
PORT=3000

# HOST: Network interface binding (0.0.0.0 listens on all interfaces / LAN)
HOST="0.0.0.0"

# APP_URL: The public or LAN URL where this operations console backend is hosted.
# Used for QR code pairing with mobile field units, telemetry webhooks, and remote node sync.
APP_URL="http://localhost:3000"

# CORS_ALLOWED_ORIGINS: Comma-delimited list of allowed origins for cross-PC authentication.
# Localhost, 127.0.0.1, and standard LAN IPs (192.168.*, 10.*, 172.16-31.*) are automatically permitted in dev.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ============================================================================
# SHARED AUTHORITATIVE DATABASE CONFIGURATION
# ============================================================================
# DATABASE_PATH: Platform-independent relative or absolute path for shared database persistence.
# Default: ./data/polar-database.json
DATABASE_PATH="./data/polar-database.json"

# AUTH_SECRET: Cryptographic secret used for session tokens and forensic signatures
AUTH_SECRET="polar-ops-secret-key-2026"

# ============================================================================
# FRONTEND & TAURI 2 NATIVE CLIENT CONFIGURATION (Vite / Desktop / Mobile)
# ============================================================================
# VITE_API_BASE_URL: Centralized API Gateway URL for all frontend requests.
#
# FOR ANDROID MOBILE BUILDS:
# Physical Android phones CANNOT reach 'localhost' or '127.0.0.1'.
# When testing on Android via an ngrok tunnel from your dev computer:
# 1. Start your backend: npm run dev (or node dist/server.cjs)
# 2. Expose via ngrok:   ngrok http 3000
# 3. Set this variable:  VITE_API_BASE_URL="https://YOUR-SUBDOMAIN.ngrok-free.app"
# 4. Build the APK:      npm run build && npx tauri android build --apk --target aarch64
#
# FOR LOCAL BROWSER DEVELOPMENT:
# .env.development automatically provides: VITE_API_BASE_URL="http://localhost:3000"
VITE_API_BASE_URL="https://YOUR-NGROK-SUBDOMAIN.ngrok-free.app"

# VITE_BACKEND_URL: Target backend URL used by the Vite development proxy
VITE_BACKEND_URL="http://localhost:3000"

# SECURITY NOTICE FOR TAURI BUILDS:
# The Tauri native bundle contains only the client frontend. NEVER expose server secrets
# (GEMINI_API_KEY, AUTH_SECRET, database paths) in client bundles or VITE_ variables!

# ============================================================================
# SATELLITE & AI TELEMETRY ENGINES (OPTIONAL)
# ============================================================================
# POLAR_SATELLITE_UPLINK_KEY: Optional API key for high-latitude satellite and weather data links.
POLAR_SATELLITE_UPLINK_KEY=""

# GEMINI_API_KEY: Optional API key for automated reconnaissance log synthesis and route risk evaluations.
GEMINI_API_KEY=""

# GOOGLE_MAPS_API_KEY / VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API Key for real satellite and terrain map rendering.
# Can use standard GCP API key or free Maps Demo Key (https://mapsplatform.google.com/maps-demo-key)
VITE_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_API_KEY=""
