# Polar Expedition Operations Telemetry & Workstation Configuration
# PORT: Local and container binding port (default: 3000)
PORT=3000

# APP_URL: The URL where this operations console is hosted.
# Used for QR code pairing with mobile field units, telemetry webhooks, and remote node sync.
APP_URL="http://localhost:3000"

# POLAR_SATELLITE_UPLINK_KEY: Optional API key for high-latitude satellite and weather data links.
POLAR_SATELLITE_UPLINK_KEY=""

# GEMINI_API_KEY: Optional API key for automated reconnaissance log synthesis and route risk evaluations.
GEMINI_API_KEY=""
