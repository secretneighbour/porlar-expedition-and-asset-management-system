# ============================================================================
# POLAR EXPEDITION & ASSET MANAGEMENT SYSTEM - EXAMPLE CONFIGURATION (.env.example)
# Copy this template to .env to configure your local, desktop, mobile, or cloud setup.
# IMPORTANT: This file contains PLACEHOLDERS ONLY. Do NOT put real secrets here.
# ============================================================================

# ============================================================================
# 1. CENTRALIZED BACKEND & API GATEWAY CONFIGURATION
# ============================================================================
# VITE_API_BASE_URL: Centralized Backend Gateway URL for web, desktop, and mobile.
VITE_API_BASE_URL="https://your-polar-deployment.vercel.app"

# VITE_API_URL: Direct alias for VITE_API_BASE_URL
VITE_API_URL="https://your-polar-deployment.vercel.app"

# VITE_BACKEND_URL: Target backend URL used by development proxy and build runners
VITE_BACKEND_URL="https://your-polar-deployment.vercel.app"

# APP_URL: Public production or LAN URL where this operations console is accessible.
APP_URL="http://localhost:3000"

# ============================================================================
# 2. SERVER & NETWORK BINDING (Standalone Multi-PC / Container Deployments)
# ============================================================================
# PORT: Local and container binding port (default: 3000)
PORT=3000

# HOST: Network interface binding (0.0.0.0 listens on all interfaces / LAN)
HOST="0.0.0.0"

# CORS_ALLOWED_ORIGINS: Comma-delimited list of allowed origins for cross-terminal access.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,tauri://localhost,https://tauri.localhost"

# ============================================================================
# 3. DATABASE & AUTHENTICATION SECRETS
# ============================================================================
# DATABASE_PATH: Platform-independent relative or absolute path for local database persistence.
DATABASE_PATH="./data/polar-database.json"

# AUTH_SECRET: Cryptographic secret used for session tokens and forensic signatures
AUTH_SECRET="your-crypto-secret-key-here"

# ============================================================================
# 4. SUPABASE PERSISTENCE & REALTIME GATEWAY CONFIGURATION (OPTIONAL)
# ============================================================================
# VITE_SUPABASE_URL: Supabase Project API Gateway URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Client-safe Supabase Anonymous Key
VITE_SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Privileged Supabase Service Key (server-side only)
SUPABASE_SERVICE_ROLE_KEY=""

# ============================================================================
# 5. GEMINI AI API KEYS (Autonomous Risk Evaluation & SAR Coordination)
# ============================================================================
# VITE_GEMINI_API_KEY: Gemini API Key for client-side waypoint risk evaluations.
VITE_GEMINI_API_KEY=""

# GEMINI_API_KEY: Gemini API Key for server-side AI processing (server.ts)
GEMINI_API_KEY=""

# ============================================================================
# 6. GIS & MAP SERVICES CONFIGURATION
# ============================================================================
# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API Key for client-side map rendering.
VITE_GOOGLE_MAPS_API_KEY=""

# GOOGLE_MAPS_API_KEY: Google Maps Platform Key for server-side geocoding/elevation checks
GOOGLE_MAPS_API_KEY=""

# ============================================================================
# 7. SATELLITE & TELEMETRY UPLINK CONFIGURATION
# ============================================================================
# POLAR_SATELLITE_UPLINK_KEY: Optional API key for high-latitude satellite and weather data links.
POLAR_SATELLITE_UPLINK_KEY=""
